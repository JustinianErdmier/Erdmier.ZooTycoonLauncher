<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:launcher="clr-namespace:Erdmier.ZooTycoonLauncher.Launcher"
             x:Class="Erdmier.ZooTycoonLauncher.Launcher.App"
             RequestedThemeVariant="{x:Static ClassicTheme.Classic}">
    <!--“Default” ThemeVariant follows the system theme variant. “Dark” or “Light” are other available options.-->

    <Application.DataTemplates>
        <launcher:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Launcher/Resources/IniTooltips.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <ClassicTheme />

        <StyleInclude Source="avares://Classic.Avalonia.Theme.DataGrid/Classic.axaml" />
        <StyleInclude Source="avares://Classic.Avalonia.Theme.Dock/Classic.axaml" />
    </Application.Styles>
</Application>
