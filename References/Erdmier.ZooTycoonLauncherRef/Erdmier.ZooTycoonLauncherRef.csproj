<Project Sdk="Microsoft.NET.Sdk">
    <!--
        Read-only inspiration; not part of the active build.
        CLAUDE.md ¶ "preserved read-only ... for visual inspiration only. **Never copy-paste from the Ref assembly**".

        The Ref project remains visible in the solution for IDE navigation, but the SDK is told
        to discover no source files, AXAML resources, or package references. The build target
        succeeds without producing meaningful output. Editing existing source files inside
        References/Erdmier.ZooTycoonLauncherRef/ does not affect the active build.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <EnableDefaultItems>false</EnableDefaultItems>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <EnableDefaultAvaloniaResources>false</EnableDefaultAvaloniaResources>
        <IsPackable>false</IsPackable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>
</Project>
