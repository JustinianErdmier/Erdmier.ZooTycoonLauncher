<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:composition="using:Erdmier.ZooTycoonLauncher.Desktop.Composition"
             xmlns:commonControls="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
             x:Class="Erdmier.ZooTycoonLauncher.Desktop.App"
             RequestedThemeVariant="{x:Static ClassicTheme.Classic}">
    <Application.DataTemplates>
        <composition:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <ClassicTheme />
        <StyleInclude Source="avares://Classic.Avalonia.Theme.DataGrid/Classic.axaml" />
        <StyleInclude Source="avares://Classic.Avalonia.Theme.Dock/Classic.axaml" />

        <!-- Win95/98 paints a read-only edit control in the 3D-face grey with normal text. The Classic theme only greys disabled TextBoxes, so mirror its :disabled background here. -->
        <Style Selector="TextBox[IsReadOnly=True] /template/ ClassicBorderDecorator#Bd">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static commonControls:SystemColors.ControlBrushKey}}" />
        </Style>
    </Application.Styles>
</Application>
