<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Erdmier.ZooTycoonLauncher.Desktop.ViewModels.Boot"
             x:Class="Erdmier.ZooTycoonLauncher.Desktop.Views.Boot.LookingForZooTycoonView"
             x:DataType="vm:LookingForZooTycoonViewModel">
    <DockPanel HorizontalSpacing="{StaticResource GapRelated}">
        <Image Classes="IconLarge IconBesideBody"
               RenderOptions.BitmapInterpolationMode="None"
               Source="/Assets/Win95Icons/searchcomputer16.ico"
               VerticalAlignment="Top" />

        <StackPanel Orientation="Vertical"
                    Spacing="{StaticResource GapRelated}">
            <TextBlock FontWeight="{StaticResource FontWeightHeading}"
                       Text="Looking for Zoo Tycoon…" />

            <ProgressBar HorizontalAlignment="Stretch"
                         IsIndeterminate="True" />

            <TextBlock Foreground="{StaticResource ForegroundMuted}"
                       Text="{Binding CurrentPhrase}" />
        </StackPanel>
    </DockPanel>
</UserControl>
