<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Erdmier.ZooTycoonLauncher.Desktop.ViewModels.Common"
             x:Class="Erdmier.ZooTycoonLauncher.Desktop.Views.Common.InstallationFormView"
             x:DataType="vm:InstallationFormViewModel">
    <StackPanel Orientation="Vertical"
                Spacing="{StaticResource GapUnrelated}">
        <Grid ColumnDefinitions="15*, 85*"
              RowDefinitions="*, *, *"
              RowSpacing="{StaticResource GapRelated}">
            <TextBlock Grid.Column="0"
                       Grid.Row="0"
                       Text="Name:" />

            <TextBox Grid.Column="1"
                     Grid.Row="0"
                     IsEnabled="{Binding AreInputsEnabled}"
                     Text="{Binding Name, Mode=TwoWay}" />

            <TextBlock Grid.Column="0"
                       Grid.Row="1"
                       Text="Folder:" />

            <DockPanel Grid.Column="1"
                       Grid.Row="1"
                       HorizontalSpacing="{StaticResource GapRelated}">
                <Button DockPanel.Dock="Right"
                        Command="{Binding BrowseCommand}"
                        Content="Browse…"
                        IsVisible="{Binding IsBrowseVisible}"
                        Classes="DialogButton" />

                <TextBox FontFamily="{StaticResource FontFamilyMono}"
                         IsReadOnly="{Binding IsFolderReadOnly}"
                         Text="{Binding Path, Mode=TwoWay}" />
            </DockPanel>

            <CheckBox Content="Mark as default installation"
                      Grid.Column="1"
                      Grid.Row="2"
                      IsChecked="{Binding MakeDefault, Mode=TwoWay}"
                      IsEnabled="{Binding CanChangeDefault}" />
        </Grid>

        <DockPanel HorizontalSpacing="{StaticResource GapRelated}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Image DockPanel.Dock="Left"
                   Classes="IconSmall"
                   RenderOptions.BitmapInterpolationMode="None"
                   Source="/Assets/Win95Icons/cancel16.gif"
                   VerticalAlignment="Center" />

            <TextBlock Foreground="{StaticResource AccentRed}"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
        </DockPanel>
    </StackPanel>
</UserControl>
