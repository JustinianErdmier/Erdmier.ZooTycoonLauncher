<ClassicWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:tokens="using:Erdmier.ZooTycoonLauncher.Desktop.Styles"
               xmlns:vm="using:Erdmier.ZooTycoonLauncher.Desktop.ViewModels.Dialogs"
               xmlns:layout="clr-namespace:Erdmier.ZooTycoonLauncher.Desktop.Views.Layout"
               xmlns:common="using:Erdmier.ZooTycoonLauncher.Desktop.Views.Common"
               x:Class="Erdmier.ZooTycoonLauncher.Desktop.Views.Dialogs.AddInstallationDialogView"
               x:DataType="vm:AddInstallationDialogViewModel"
               Icon="/Assets/Win95Icons/foldercatalog16.ico"
               Title="  Add Installation"
               Width="420"
               SizeToContent="Height"
               CanResize="False"
               WindowStartupLocation="CenterOwner"
               ShowInTaskbar="False">
    <StackPanel Margin="{tokens:Space MarginDialog}"
                Orientation="Vertical"
                Spacing="{StaticResource GapUnrelated}">
        <DockPanel HorizontalSpacing="{StaticResource GapRelated}">
            <Image DockPanel.Dock="Left"
                   Classes="IconLarge IconBesideBody"
                   RenderOptions.BitmapInterpolationMode="None"
                   Source="/Assets/Win95Icons/foldercatalog16.ico"
                   VerticalAlignment="Top" />

            <StackPanel Orientation="Vertical"
                        Spacing="{StaticResource GapRelated}">
                <TextBlock FontWeight="{StaticResource FontWeightHeading}"
                           Text="New Installation" />

                <TextBlock
                    Text="Register a Zoo Tycoon installation with the launcher. This does not install the game to your machine; it tells the launcher where an already installed copy of the game exists."
                    TextWrapping="Wrap" />

                <Separator />

                <TextBlock Text="Give this installation a unique name, or use the one suggested. The folder you selected should be the root folder containing the zoo.exe file."
                           TextWrapping="Wrap" />

                <common:InstallationFormView DataContext="{Binding Form}" />

                <layout:UniformStack HorizontalAlignment="Right"
                                     Margin="{tokens:Space Top=GapUnrelated}"
                                     Spacing="{StaticResource GapRelated}">
                    <Button Command="{Binding SaveCommand}"
                            Content="Save"
                            IsDefault="True"
                            Classes="DialogButton" />
                    <Button Command="{Binding CancelCommand}"
                            Content="Cancel"
                            IsCancel="True"
                            Classes="DialogButton" />
                </layout:UniformStack>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</ClassicWindow>
