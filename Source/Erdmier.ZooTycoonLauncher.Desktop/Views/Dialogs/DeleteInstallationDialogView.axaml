<ClassicWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:tokens="using:Erdmier.ZooTycoonLauncher.Desktop.Styles"
               xmlns:vm="using:Erdmier.ZooTycoonLauncher.Desktop.ViewModels.Dialogs"
               xmlns:layout="clr-namespace:Erdmier.ZooTycoonLauncher.Desktop.Views.Layout"
               x:Class="Erdmier.ZooTycoonLauncher.Desktop.Views.Dialogs.DeleteInstallationDialogView"
               x:DataType="vm:DeleteInstallationDialogViewModel"
               Icon="/Assets/Win95Icons/warning32.gif"
               Title="  Delete Installation"
               Width="440"
               SizeToContent="Height"
               CanResize="False"
               WindowStartupLocation="CenterOwner"
               ShowInTaskbar="False">
    <StackPanel Margin="{tokens:Space MarginDialog}"
                Orientation="Vertical"
                Spacing="{StaticResource GapUnrelated}">
        <DockPanel HorizontalSpacing="{StaticResource GapRelated}">
            <Image DockPanel.Dock="Left"
                   Classes="IconLarge IconBesideBody"
                   RenderOptions.BitmapInterpolationMode="None"
                   Source="/Assets/Win95Icons/warning32.gif"
                   VerticalAlignment="Top" />

            <StackPanel Orientation="Vertical"
                        Spacing="{StaticResource GapUnrelated}">
                <TextBlock IsVisible="{Binding IsLoaded}"
                           TextWrapping="Wrap">
                    <Run Text="Remove " /><Run FontWeight="{StaticResource FontWeightStrong}"
                                                Text="{Binding InstallationName}" /><Run Text=" from the launcher's registry?" />
                </TextBlock>

                <TextBlock IsVisible="{Binding IsLoaded}"
                           Classes="MutedText"
                           Text="The launcher's database for this installation, including INI history, will be deleted. The game folder on disk is left untouched."
                           TextWrapping="Wrap" />

                <TextBlock IsVisible="{Binding HasPromotion}"
                           TextWrapping="Wrap">
                    <Run FontWeight="{StaticResource FontWeightStrong}"
                         Text="{Binding PromotedName}" /><Run Text=" will be promoted to default." />
                </TextBlock>

                <TextBlock IsVisible="{Binding IsLastInstallation}"
                           Text="No installations will remain."
                           TextWrapping="Wrap" />

                <TextBlock Foreground="{StaticResource AccentRed}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" />

                <layout:UniformStack HorizontalAlignment="Right"
                                     Margin="{tokens:Space Vertical=GapLabel}"
                                     Spacing="{StaticResource GapRelated}">
                    <Button Command="{Binding DeleteCommand}"
                            Content="Delete"
                            Classes="DialogButton" />
                    <Button Command="{Binding CancelCommand}"
                            Content="Cancel"
                            IsCancel="True"
                            IsDefault="True"
                            Classes="DialogButton" />
                </layout:UniformStack>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</ClassicWindow>
