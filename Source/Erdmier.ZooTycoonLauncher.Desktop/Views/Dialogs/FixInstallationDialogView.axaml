<ClassicWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:Erdmier.ZooTycoonLauncher.Desktop.ViewModels.Dialogs"
               xmlns:controls="clr-namespace:Classic.Avalonia.Theme.Controls;assembly=Classic.Avalonia.Theme"
               x:Class="Erdmier.ZooTycoonLauncher.Desktop.Views.Dialogs.FixInstallationDialogView"
               x:DataType="vm:FixInstallationDialogViewModel"
               Icon="/Assets/Win95Icons/warning32.gif"
               Title="  Fix Installation"
               Width="460"
               SizeToContent="Height"
               CanResize="False"
               WindowStartupLocation="CenterOwner"
               ShowInTaskbar="False">
    <StackPanel Margin="8"
                Orientation="Vertical"
                Spacing="10">
        <TextBlock Opacity="0.6"
                   TextWrapping="Wrap">
            <Run Text="Recover an installation by locating missing files or restoring a fresh INI. The launcher never patches " /><Run FontFamily="{StaticResource FontFamilyMono}"
                                                                                                                                       Text="zoo.exe" /><Run Text="." />
        </TextBlock>

        <TextBlock Foreground="{StaticResource AccentRed}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />

        <controls:GroupBox Header="Fix EXE"
                           IsVisible="{Binding IsLoaded}">
            <DockPanel HorizontalSpacing="10"
                       Margin="4">
                <Image DockPanel.Dock="Left"
                       Height="32"
                       IsVisible="{Binding HasExe}"
                       Source="/Assets/Win95Icons/ok32.gif"
                       VerticalAlignment="Top"
                       Width="32" />

                <Image DockPanel.Dock="Left"
                       Height="32"
                       IsVisible="{Binding !HasExe}"
                       Source="/Assets/Win95Icons/error32.gif"
                       VerticalAlignment="Top"
                       Width="32" />

                <Button DockPanel.Dock="Right"
                        Command="{Binding LocateCommand}"
                        Content="Locate…"
                        MinWidth="75"
                        VerticalAlignment="Top" />

                <StackPanel Orientation="Vertical"
                            Spacing="4">
                    <StackPanel IsVisible="{Binding HasExe}"
                                Orientation="Vertical"
                                Spacing="4">
                        <TextBlock Foreground="{StaticResource AccentGreen}"
                                   Text="EXE present" />
                        <TextBlock Opacity="0.6"
                                   TextWrapping="Wrap">
                            <Run FontFamily="{StaticResource FontFamilyMono}"
                                 Text="zoo.exe" /><Run Text=" was located at the expected path." />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding !HasExe}"
                                Orientation="Vertical"
                                Spacing="4">
                        <TextBlock Foreground="{StaticResource AccentRed}"
                                   Text="No EXE found!" />
                        <TextBlock Opacity="0.6"
                                   TextWrapping="Wrap">
                            <Run FontFamily="{StaticResource FontFamilyMono}"
                                 Text="zoo.exe" /><Run Text=" is missing from this installation's directory. Browse to a folder that contains " /><Run FontFamily="{StaticResource FontFamilyMono}"
                                                                                                                                                       Text="zoo.exe" /><Run Text="." />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Foreground="{StaticResource AccentRed}"
                               IsVisible="{Binding ExeErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding ExeErrorMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </controls:GroupBox>

        <controls:GroupBox Header="Fix INI"
                           IsVisible="{Binding IsLoaded}">
            <DockPanel HorizontalSpacing="10"
                       Margin="4">
                <Image DockPanel.Dock="Left"
                       Height="32"
                       IsVisible="{Binding HasIni}"
                       Source="/Assets/Win95Icons/ok32.gif"
                       VerticalAlignment="Top"
                       Width="32" />

                <Image DockPanel.Dock="Left"
                       Height="32"
                       IsVisible="{Binding !HasIni}"
                       Source="/Assets/Win95Icons/error32.gif"
                       VerticalAlignment="Top"
                       Width="32" />

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Vertical"
                            Spacing="6"
                            VerticalAlignment="Top">
                    <Button Command="{Binding CreateIniCommand}"
                            Content="Create"
                            MinWidth="75" />

                    <Button Command="{Binding LocateIniCommand}"
                            Content="Locate…"
                            MinWidth="75" />
                </StackPanel>

                <StackPanel Orientation="Vertical"
                            Spacing="4">
                    <StackPanel IsVisible="{Binding HasIni}"
                                Orientation="Vertical"
                                Spacing="4">
                        <TextBlock Foreground="{StaticResource AccentGreen}"
                                   Text="INI present" />
                        <TextBlock Opacity="0.6"
                                   TextWrapping="Wrap">
                            <Run FontFamily="{StaticResource FontFamilyMono}"
                                 Text="zoo.ini" /><Run Text=" was found in the installation folder." />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding !HasIni}"
                                Orientation="Vertical"
                                Spacing="4">
                        <TextBlock Foreground="{StaticResource AccentAmber}"
                                   Text="No INI found" />
                        <TextBlock Opacity="0.6"
                                   TextWrapping="Wrap">
                            <Run Text="Create a fresh " /><Run FontFamily="{StaticResource FontFamilyMono}"
                                                              Text="zoo.ini" /><Run Text=" from the launcher's defaults, or locate an existing file to copy in. Any earlier values stay in history." />
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource AccentMaroon}"
                                   IsVisible="{Binding IniErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding IniErrorMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </controls:GroupBox>

        <Button Command="{Binding OkCommand}"
                Content="OK"
                HorizontalAlignment="Right"
                IsCancel="True"
                IsDefault="True"
                MinWidth="75" />
    </StackPanel>
</ClassicWindow>
