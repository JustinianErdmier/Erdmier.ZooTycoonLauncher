<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tokens="using:Erdmier.ZooTycoonLauncher.Desktop.Styles"
        xmlns:vm="using:Erdmier.ZooTycoonLauncher.Desktop.ViewModels.Dialogs"
        x:Class="Erdmier.ZooTycoonLauncher.Desktop.Views.Dialogs.LaunchErrorView"
        x:DataType="vm:LaunchErrorViewModel"
        Title="Cannot Launch Zoo Tycoon"
        Width="500"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- Mirror MainWindow's caption-button hiding so the Classic theme renders the title bar with only a close button (the Ref build's ConfirmDialogView did the same). -->
    <Window.Styles>
        <Style Selector="CaptionButtons /template/ Button#PART_MinimizeButton">
            <Setter Property="IsVisible"
                    Value="False" />
        </Style>
        <Style Selector="CaptionButtons /template/ Button#PART_RestoreButton">
            <Setter Property="IsVisible"
                    Value="False" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="{tokens:Space MarginDialog}"
                Orientation="Vertical"
                Spacing="{StaticResource GapUnrelated}">
        <DockPanel HorizontalSpacing="{StaticResource GapRelated}">
            <Image DockPanel.Dock="Left"
                   Classes="IconLarge IconBesideMessage"
                   RenderOptions.BitmapInterpolationMode="None"
                   Source="/Assets/Win95Icons/cancel32.gif"
                   VerticalAlignment="Center" />

            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap" />
        </DockPanel>

        <Button Click="OnOkClick"
                Content="OK"
                HorizontalAlignment="Center"
                IsDefault="True"
                MinWidth="80" />
    </StackPanel>
</Window>
