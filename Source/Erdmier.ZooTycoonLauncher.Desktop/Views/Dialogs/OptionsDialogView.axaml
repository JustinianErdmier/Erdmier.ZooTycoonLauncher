<ClassicWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:Erdmier.ZooTycoonLauncher.Desktop.ViewModels.Dialogs"
               xmlns:controls="clr-namespace:Classic.Avalonia.Theme.Controls;assembly=Classic.Avalonia.Theme"
               xmlns:layout="clr-namespace:Erdmier.ZooTycoonLauncher.Desktop.Views.Layout"
               x:Class="Erdmier.ZooTycoonLauncher.Desktop.Views.Dialogs.OptionsDialogView"
               x:DataType="vm:OptionsDialogViewModel"
               Icon="/Assets/Win95Icons/controls32.ico"
               Title="  Options"
               Width="460"
               SizeToContent="Height"
               CanResize="False"
               WindowStartupLocation="CenterOwner"
               ShowInTaskbar="False">
    <StackPanel Margin="8"
                Orientation="Vertical"
                Spacing="10">
        <TextBlock Foreground="{StaticResource AccentRed}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />

        <controls:GroupBox Header="Startup"
                           Padding="10 15">
            <StackPanel Orientation="Vertical"
                        Spacing="4">
                <TextBlock Opacity="0.6"
                           Text="When the launcher opens, restore:" />

                <RadioButton Content="The default installation"
                             GroupName="Startup"
                             IsChecked="{Binding IsDefaultInstallation}" />

                <RadioButton Content="The installation I last played"
                             GroupName="Startup"
                             IsChecked="{Binding IsLastPlayedInstallation}" />

                <RadioButton Content="The installation I last opened in the launcher"
                             GroupName="Startup"
                             IsChecked="{Binding IsLastOpenedInstallation}" />

                <RadioButton Content="No installation — show the picker"
                             GroupName="Startup"
                             IsChecked="{Binding IsNoInstallation}" />
            </StackPanel>
        </controls:GroupBox>

        <controls:GroupBox Header="Game launch"
                           Padding="10 15">
            <StackPanel Orientation="Vertical"
                        Spacing="4">
                <CheckBox Content="Close launcher after the game starts"
                          IsChecked="{Binding CloseAfterGameLaunch}" />

                <TextBlock Margin="20 0 0 0"
                           Opacity="0.6"
                           TextWrapping="Wrap">
                    <Run Text="When ticked, the launcher exits as soon as " /><Run FontFamily="Consolas"
                                                                                   Text="zoo.exe" /><Run Text=" reports started." />
                </TextBlock>
            </StackPanel>
        </controls:GroupBox>

        <layout:UniformStack HorizontalAlignment="Right"
                             Margin="0 5"
                             Spacing="8">
            <Button Command="{Binding OkCommand}"
                    Content="OK"
                    IsDefault="True"
                    MinWidth="75" />
            <Button Command="{Binding CancelCommand}"
                    Content="Cancel"
                    IsCancel="True"
                    MinWidth="75" />
        </layout:UniformStack>
    </StackPanel>
</ClassicWindow>
