<ClassicWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:Erdmier.ZooTycoonLauncher.Desktop.ViewModels.Dialogs"
               xmlns:models="using:Erdmier.ZooTycoonLauncher.Desktop.Models.IniConfig"
               x:Class="Erdmier.ZooTycoonLauncher.Desktop.Views.Dialogs.RestorePreviousIniDialogView"
               x:DataType="vm:RestorePreviousIniDialogViewModel"
               Icon="/Assets/Win95Icons/sheetsanddocuments32.ico"
               Title="  Restore Previous INI"
               Width="620"
               SizeToContent="Height"
               CanResize="False"
               WindowStartupLocation="CenterOwner"
               ShowInTaskbar="False">
    <StackPanel Margin="12"
                Orientation="Vertical"
                Spacing="8">
        <TextBlock Opacity="0.6"
                   Text="Pick a previous version of zoo.ini to restore. The current version is archived to history before the restore is applied."
                   TextWrapping="Wrap" />

        <TextBlock Foreground="Red"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" />

        <!-- Snapshot history, newest first -->
        <DataGrid AutoGenerateColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  Height="140"
                  IsReadOnly="True"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Captured"
                                        Width="45*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:IniHistoryRow">
                            <TextBlock FontFamily="Consolas"
                                       FontSize="11"
                                       Margin="4 0"
                                       Text="{Binding CapturedText}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding TriggerText}"
                                    Header="Trigger"
                                    Width="30*" />

                <DataGridTemplateColumn Header="Δ keys"
                                        Width="25*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:IniHistoryRow">
                            <TextBlock FontFamily="Consolas"
                                       HorizontalAlignment="Right"
                                       Margin="4 0"
                                       Text="{Binding DeltaText}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Caption row -->
        <Grid ColumnDefinitions="*, Auto">
            <TextBlock FontSize="11"
                       Opacity="0.6"
                       Text="Diff: values from the selected snapshot replace the current ones on restore." />

            <TextBlock Grid.Column="1"
                       FontSize="11"
                       Opacity="0.6"
                       Text="{Binding ChangeCountText}" />
        </Grid>

        <!-- Differences of the selected snapshot -->
        <Panel Height="140">
            <DataGrid AutoGenerateColumns="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      FontSize="11"
                      IsReadOnly="True"
                      IsVisible="{Binding !HasNoDifferences}"
                      ItemsSource="{Binding DiffRows}"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Key"
                                            Width="45*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="models:IniHistoryDiffRow">
                                <TextBlock FontFamily="Consolas"
                                           Margin="4 0"
                                           VerticalAlignment="Center">
                                    <Run Foreground="Gray"
                                         Text="{Binding SectionText}" /><Run Text="/" /><Run Text="{Binding KeyText}" />
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Current"
                                            Width="27.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="models:IniHistoryDiffRow">
                                <TextBlock FontFamily="Consolas"
                                           Foreground="Maroon"
                                           Margin="4 0"
                                           Text="{Binding CurrentText}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Snapshot"
                                            Width="27.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="models:IniHistoryDiffRow">
                                <TextBlock FontFamily="Consolas"
                                           Foreground="Navy"
                                           Margin="4 0"
                                           Text="{Binding SnapshotText}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock FontStyle="Italic"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding HasNoDifferences}"
                       Margin="14"
                       Opacity="0.6"
                       Text="No differences — this snapshot matches the current state."
                       TextAlignment="Center"
                       VerticalAlignment="Top" />
        </Panel>

        <TextBlock FontSize="11"
                   Foreground="Maroon"
                   IsVisible="{Binding HasKeptKeys}"
                   Text="{Binding KeptKeysText}"
                   TextWrapping="Wrap" />

        <StackPanel HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="6">
            <Button Command="{Binding RestoreCommand}"
                    Content="Restore"
                    IsDefault="True"
                    MinWidth="75" />

            <Button Command="{Binding CancelCommand}"
                    Content="Cancel"
                    IsCancel="True"
                    MinWidth="75" />
        </StackPanel>
    </StackPanel>
</ClassicWindow>
