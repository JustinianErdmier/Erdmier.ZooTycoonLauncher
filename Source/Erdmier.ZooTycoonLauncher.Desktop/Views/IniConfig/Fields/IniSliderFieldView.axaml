<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Erdmier.ZooTycoonLauncher.Desktop.ViewModels.IniConfig.Fields"
             x:Class="Erdmier.ZooTycoonLauncher.Desktop.Views.IniConfig.Fields.IniSliderFieldView"
             x:DataType="vm:IniSliderFieldViewModel">
    <StackPanel Orientation="Horizontal"
                Spacing="{StaticResource GapRelated}">
        <Slider x:Name="VolumeSlider"
                LargeChange="10"
                Maximum="100"
                Minimum="0"
                SmallChange="1"
                TickFrequency="10"
                TickPlacement="BottomRight"
                Value="{Binding Percent}"
                VerticalAlignment="Center"
                Width="200" />

        <TextBlock FontFamily="{StaticResource FontFamilyMono}"
                   MinWidth="40"
                   Text="{Binding PercentText}"
                   VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
