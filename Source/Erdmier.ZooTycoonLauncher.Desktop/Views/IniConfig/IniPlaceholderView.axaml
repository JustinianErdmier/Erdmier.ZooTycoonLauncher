<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Erdmier.ZooTycoonLauncher.Desktop.ViewModels.IniConfig"
             xmlns:controls="clr-namespace:Classic.Avalonia.Theme.Controls;assembly=Classic.Avalonia.Theme"
             x:Class="Erdmier.ZooTycoonLauncher.Desktop.Views.IniConfig.IniPlaceholderView"
             x:DataType="vm:IniPlaceholderViewModel">
    <controls:GroupBox Header="INI status"
                       Margin="8"
                       Padding="10 15"
                       VerticalAlignment="Top">
        <DockPanel HorizontalSpacing="10">
            <Image DockPanel.Dock="Left"
                   Height="32"
                   IsVisible="{Binding ShowWarningIcon}"
                   Source="/Assets/Win95Icons/warning32.gif"
                   VerticalAlignment="Top"
                   Width="32" />

            <StackPanel Spacing="4">
                <TextBlock FontWeight="{StaticResource FontWeightStrong}"
                           Text="{Binding Headline}" />

                <TextBlock Foreground="{StaticResource ForegroundMuted}"
                           IsVisible="{Binding ShowPlainBody}"
                           Text="{Binding Body}"
                           TextWrapping="Wrap" />

                <!-- The No INI body (spec C9): same wording as the view model's Body, with zoo.ini in the monospace used elsewhere on the tab. -->
                <TextBlock Foreground="{StaticResource ForegroundMuted}"
                           IsVisible="{Binding HasActions}"
                           TextWrapping="Wrap">
                    <Run Text="This installation has no " /><Run FontFamily="{StaticResource FontFamilyMono}"
                                                                 Text="zoo.ini" /><Run Text=" on disk. Create a fresh one from the launcher's defaults, or locate an existing file to copy in." />
                </TextBlock>

                <StackPanel IsVisible="{Binding HasActions}"
                            Margin="0 8 0 0"
                            Orientation="Horizontal"
                            Spacing="6">
                    <Button Command="{Binding CreateCommand}"
                            Content="Create zoo.ini from defaults"
                            IsDefault="True"
                            MinWidth="75" />

                    <Button Command="{Binding LocateCommand}"
                            Content="Locate existing zoo.ini…"
                            MinWidth="75" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </controls:GroupBox>
</UserControl>
