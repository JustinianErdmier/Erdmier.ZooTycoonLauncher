<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tokens="using:Erdmier.ZooTycoonLauncher.Desktop.Styles"
             xmlns:vm="using:Erdmier.ZooTycoonLauncher.Desktop.ViewModels.Tabs"
             xmlns:controls="clr-namespace:Classic.Avalonia.Theme.Controls;assembly=Classic.Avalonia.Theme"
             x:Class="Erdmier.ZooTycoonLauncher.Desktop.Views.Tabs.GeneralTabView"
             x:DataType="vm:GeneralTabViewModel">
    <StackPanel Margin="{tokens:Space MarginDialog}"
                Spacing="{StaticResource GapUnrelated}">
        <StackPanel Orientation="Horizontal"
                    Spacing="{StaticResource GapLabel}">
            <TextBlock Text="Installation Profile:" />

            <TextBlock Text="{Binding InstallationName}"
                       FontWeight="{StaticResource FontWeightStrong}" />
        </StackPanel>

        <controls:GroupBox Header="Status"
                           Padding="{StaticResource GroupBoxPadding}">
            <DockPanel HorizontalSpacing="{StaticResource GapRelated}">
                <Image DockPanel.Dock="Left"
                       Classes="IconLarge IconBesideBody"
                       RenderOptions.BitmapInterpolationMode="None"
                       IsVisible="{Binding CanPlay}"
                       Source="/Assets/Win95Icons/ok32.gif"
                       VerticalAlignment="Top" />

                <Image DockPanel.Dock="Left"
                       Classes="IconLarge IconBesideBody"
                       RenderOptions.BitmapInterpolationMode="None"
                       IsVisible="{Binding !CanPlay}"
                       Source="/Assets/Win95Icons/warning32.gif"
                       VerticalAlignment="Top" />

                <Button Command="{Binding LaunchCommand}"
                        DockPanel.Dock="Right"
                        IsDefault="True"
                        IsVisible="{Binding CanPlay}"
                        VerticalAlignment="Center">
                    Launch Game
                </Button>

                <Button Command="{Binding OpenInstallationManagerCommand}"
                        DockPanel.Dock="Right"
                        IsDefault="True"
                        IsVisible="{Binding !CanPlay}"
                        VerticalAlignment="Top">
                    Open Installation Manager…
                </Button>

                <StackPanel Orientation="Vertical"
                            Spacing="{StaticResource GapRelated}">
                    <TextBlock FontWeight="{StaticResource FontWeightHeading}"
                               IsVisible="{Binding CanPlay}"
                               Text="Ready to Play" />

                    <TextBlock FontWeight="{StaticResource FontWeightHeading}"
                               Foreground="{StaticResource AccentRed}"
                               IsVisible="{Binding !CanPlay}"
                               Text="Cannot Play" />

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="{StaticResource GapRelated}"
                          Margin="{tokens:Space Top=GapSmallest}"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="{StaticResource GapSmallest}">
                        <TextBlock Grid.Column="0"
                                   Grid.Row="0"
                                   Text="EXE:" />

                        <TextBlock Foreground="{StaticResource AccentGreen}"
                                   Grid.Column="1"
                                   Grid.Row="0"
                                   IsVisible="{Binding HasExe}"
                                   Text="Found" />

                        <TextBlock Foreground="{StaticResource AccentRed}"
                                   Grid.Column="1"
                                   Grid.Row="0"
                                   IsVisible="{Binding !HasExe}"
                                   Text="Not found" />

                        <TextBlock Grid.Column="0"
                                   Grid.Row="1"
                                   Text="INI:" />

                        <TextBlock Foreground="{StaticResource AccentGreen}"
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   IsVisible="{Binding HasIni}"
                                   Text="Found" />

                        <TextBlock Foreground="{StaticResource AccentRed}"
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   IsVisible="{Binding !HasIni}"
                                   Text="Not found" />

                        <TextBlock Grid.Column="0"
                                   Grid.Row="2"
                                   Text="Path:" />

                        <TextBlock Grid.Column="1"
                                   Grid.Row="2"
                                   Text="{Binding InstallationPath}"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock Foreground="{StaticResource ForegroundMuted}"
                               IsVisible="{Binding IsMissingOnlyExe}"
                               Text="zoo.exe is missing from this installation's directory. The game cannot be started because it technically doesn't exist. Open the installation manager to try fixing the problem."
                               TextWrapping="Wrap" />

                    <TextBlock Foreground="{StaticResource ForegroundMuted}"
                               IsVisible="{Binding IsMissingOnlyIni}"
                               Text="{Binding MissingIniMessage}"
                               TextWrapping="Wrap" />

                    <TextBlock Foreground="{StaticResource ForegroundMuted}"
                               IsVisible="{Binding IsMissingBothExeAndIni}"
                               Text="zoo.exe and zoo.ini are missing from this installation's directory. The game cannot be started without them. Use Fix to locate or recreate the files. Open the installation manager to try fixing the problem."
                               TextWrapping="Wrap" />

                    <TextBlock Foreground="{StaticResource ForegroundMuted}"
                               IsVisible="{Binding IsIniUnreadable}"
                               TextWrapping="Wrap">
                        <Run Text="The launcher could not read zoo.ini." />
                        <LineBreak />
                        <Run Text="{Binding IniErrorMessage}" />
                    </TextBlock>

                    <TextBlock Foreground="{StaticResource ForegroundMuted}"
                               IsVisible="{Binding ShowPendingIniChangesHint}"
                               Text="Save or revert your INI changes to launch."
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </controls:GroupBox>

        <controls:GroupBox Header="Display"
                           Padding="{StaticResource GroupBoxPadding}">
            <DockPanel HorizontalSpacing="{StaticResource GapRelated}">
                <Image DockPanel.Dock="Left"
                       Classes="IconLarge IconBesideBody"
                       RenderOptions.BitmapInterpolationMode="None"
                       Source="/Assets/Win95Icons/mystify16.ico"
                       VerticalAlignment="Top" />

                <StackPanel Orientation="Vertical"
                            Spacing="{StaticResource GapRelated}">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="{StaticResource GapUnrelated}"
                          RowDefinitions="Auto,Auto, Auto, Auto"
                          RowSpacing="{StaticResource GapSmallest}">
                        <TextBlock Grid.Column="0"
                                   Grid.Row="0"
                                   Text="Current resolution:" />

                        <TextBlock Grid.Column="1"
                                   Grid.Row="0"
                                   Text="1920 x 1080 · 32-bit · 60 Hz" />

                        <TextBlock Grid.Column="0"
                                   Grid.Row="1"
                                   Text="Adapter:" />

                        <TextBlock Grid.Column="1"
                                   Grid.Row="1"
                                   Text="\\.\DISPLAY1 - Primary" />

                        <TextBlock Grid.Column="0"
                                   Grid.Row="2"
                                   Text="Available screen modes:" />

                        <TextBlock Grid.Column="1"
                                   Grid.Row="2"
                                   Text="756 reported by Windows" />

                        <TextBlock Grid.Column="0"
                                   Grid.Row="3"
                                   Text="Possible ZT1 modes:" />

                        <TextBlock Grid.Column="1"
                                   Grid.Row="3"
                                   Text="14 compatible (16-bit ≤ 1600 x 1200)" />
                    </Grid>

                    <TextBlock Foreground="{StaticResource ForegroundMuted}"
                               IsVisible="{Binding IsMissingOnlyExe}">
                        <Italic>Display detection succeeded, but the game cannot launch until the EXE is restored.</Italic>
                    </TextBlock>

                    <TextBlock Foreground="{StaticResource ForegroundMuted}"
                               IsVisible="{Binding IsMissingOnlyIni}">
                        <Italic>Display detection succeeded, but the game cannot launch until the INI is restored.</Italic>
                    </TextBlock>

                    <TextBlock Foreground="{StaticResource ForegroundMuted}"
                               IsVisible="{Binding IsMissingBothExeAndIni}">
                        <Italic>Display detection succeeded, but the game cannot launch until the EXE and INI are restored.</Italic>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </controls:GroupBox>

        <controls:GroupBox Header="Your System"
                           Padding="{StaticResource GroupBoxPadding}">
            <DockPanel HorizontalSpacing="{StaticResource GapRelated}">
                <Image DockPanel.Dock="Left"
                       Classes="IconLarge IconBesideBody"
                       RenderOptions.BitmapInterpolationMode="None"
                       Source="/Assets/Win95Icons/mycomputer16.ico"
                       VerticalAlignment="Top" />

                <StackPanel Orientation="Vertical"
                            Spacing="{StaticResource GapRelated}">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="{StaticResource GapUnrelated}"
                          RowDefinitions="Auto,Auto, Auto, Auto"
                          RowSpacing="{StaticResource GapSmallest}">
                        <TextBlock Grid.Column="0"
                                   Grid.Row="0"
                                   Text="Operating system:" />

                        <TextBlock Grid.Column="1"
                                   Grid.Row="0"
                                   Text="Windows 11 Pro · Version 24H2 · Build 26100" />

                        <TextBlock Grid.Column="0"
                                   Grid.Row="1"
                                   Text="Processor:" />

                        <TextBlock Grid.Column="1"
                                   Grid.Row="1"
                                   Text="Intel Core i7-12700K · 12C/20T · 3.60 GHz" />

                        <TextBlock Grid.Column="0"
                                   Grid.Row="2"
                                   Text="Graphics:" />

                        <TextBlock Grid.Column="1"
                                   Grid.Row="2"
                                   Text="NVIDIA GeForce RTX 3080 · 10 GB GDDR6X" />

                        <TextBlock Grid.Column="0"
                                   Grid.Row="3"
                                   Text="Memory:" />

                        <TextBlock Grid.Column="1"
                                   Grid.Row="3"
                                   Text="32 GB DDR5 · 28.4 GB available" />
                    </Grid>

                    <Separator />

                    <StackPanel IsVisible="{Binding CanPlay}"
                                Orientation="Horizontal"
                                Spacing="{StaticResource GapRelated}">
                        <Image DockPanel.Dock="Left"
                               Classes="IconSmall"
                               RenderOptions.BitmapInterpolationMode="None"
                               Source="/Assets/Win95Icons/ok16.gif"
                               VerticalAlignment="Top" />

                        <TextBlock FontWeight="{StaticResource FontWeightStrong}"
                                   Foreground="{StaticResource AccentGreen}"
                                   Text="zoo.exe is configured correctly." />

                        <TextBlock Foreground="{StaticResource ForegroundMuted}"
                                   Text="Windows XP compatibility, 16-bit colour, and fullscreen optimisations are all set." />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding !HasExe}"
                                Orientation="Horizontal"
                                Spacing="{StaticResource GapRelated}">
                        <Image DockPanel.Dock="Left"
                               Classes="IconSmall"
                               RenderOptions.BitmapInterpolationMode="None"
                               Source="/Assets/Win95Icons/error32.gif"
                               VerticalAlignment="Top" />

                        <TextBlock FontWeight="{StaticResource FontWeightStrong}"
                                   Foreground="{StaticResource AccentRed}"
                                   Text="zoo.exe is missing." />

                        <TextBlock Foreground="{StaticResource ForegroundMuted}"
                                   Text="There's no game to configure." />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </controls:GroupBox>

        <TextBlock Foreground="{StaticResource ForegroundMuted}"
                   HorizontalAlignment="Right">
            <Run Text="Last played: " /><Run Text="{Binding InstallationLastPlayed}" />
        </TextBlock>
    </StackPanel>
</UserControl>
