<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tokens="using:Erdmier.ZooTycoonNexus.Desktop.Styles"
             xmlns:vm="using:Erdmier.ZooTycoonNexus.Desktop.ViewModels.Common"
             xmlns:converters="using:Erdmier.ZooTycoonNexus.Desktop.Converters"
             xmlns:models="using:Erdmier.ZooTycoonNexus.Desktop.Models"
             x:Class="Erdmier.ZooTycoonNexus.Desktop.Views.Common.InstallationGridView"
             x:DataType="vm:InstallationGridViewModel">
    <UserControl.Resources>
        <converters:BoolToFontWeightConverter x:Key="BoolToFontWeight" />
        <converters:ValidityToBrushConverter x:Key="ValidityToBrush" />
    </UserControl.Resources>

    <DataGrid ItemsSource="{Binding Rows}"
              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
              SelectionMode="Single"
              IsReadOnly="True"
              CanUserReorderColumns="False"
              CanUserResizeColumns="False"
              CanUserSortColumns="False"
              AutoGenerateColumns="False"
              Classes="InertHeaders">
        <DataGrid.Columns>
            <DataGridTemplateColumn Header="Name"
                                    Width="*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="models:InstallationGridRowModel">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="{tokens:Space Horizontal=GapLabel}">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="{Binding IsDefault, Converter={StaticResource BoolToFontWeight}}" />

                            <TextBlock Text=" · default"
                                       IsVisible="{Binding IsDefault}"
                                       Classes="MutedText" />
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="Path"
                                Binding="{Binding Path}"
                                Width="2*" />

            <DataGridTemplateColumn Header="Status"
                                    Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="models:InstallationGridRowModel">
                        <TextBlock Text="{Binding ValidityDisplayName}"
                                   Foreground="{Binding Validity, Converter={StaticResource ValidityToBrush}}"
                                   VerticalAlignment="Center"
                                   Margin="{tokens:Space Horizontal=GapLabel}" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
