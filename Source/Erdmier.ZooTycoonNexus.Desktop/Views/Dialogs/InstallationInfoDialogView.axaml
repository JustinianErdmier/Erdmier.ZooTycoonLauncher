<ClassicWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:tokens="using:Erdmier.ZooTycoonNexus.Desktop.Styles"
               xmlns:vm="using:Erdmier.ZooTycoonNexus.Desktop.ViewModels.Dialogs"
               xmlns:converters="using:Erdmier.ZooTycoonNexus.Desktop.Converters"
               x:Class="Erdmier.ZooTycoonNexus.Desktop.Views.Dialogs.InstallationInfoDialogView"
               x:DataType="vm:InstallationInfoDialogViewModel"
               Icon="/Assets/Win95Icons/foldercatalog16.ico"
               Title="  Installation Info"
               Width="420"
               SizeToContent="Height"
               CanResize="False"
               WindowStartupLocation="CenterOwner"
               ShowInTaskbar="False">
    <ClassicWindow.Resources>
        <converters:ValidityToBrushConverter x:Key="ValidityToBrush" />
    </ClassicWindow.Resources>

    <StackPanel Margin="{tokens:Space MarginDialog}"
                Orientation="Vertical"
                Spacing="{StaticResource GapUnrelated}">
        <DockPanel HorizontalSpacing="{StaticResource GapRelated}">
            <Image DockPanel.Dock="Left"
                   Classes="IconLarge IconBesideBody"
                   RenderOptions.BitmapInterpolationMode="None"
                   Source="/Assets/Win95Icons/information32.gif"
                   VerticalAlignment="Top" />

            <StackPanel Orientation="Vertical"
                        Spacing="{StaticResource GapRelated}">
                <TextBlock Foreground="{StaticResource AccentRed}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap" />

                <Grid ColumnDefinitions="Auto, *"
                      ColumnSpacing="{StaticResource GapUnrelated}"
                      IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                      RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                      RowSpacing="{StaticResource GapRelated}">
                    <TextBlock Grid.Column="0"
                               Grid.Row="0"
                               Foreground="{StaticResource ForegroundDim}"
                               Text="Name:" />
                    <TextBlock Grid.Column="1"
                               Grid.Row="0"
                               FontWeight="{StaticResource FontWeightStrong}"
                               Text="{Binding Name}"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Column="0"
                               Grid.Row="1"
                               Foreground="{StaticResource ForegroundDim}"
                               Text="Path:" />
                    <TextBlock Grid.Column="1"
                               Grid.Row="1"
                               FontFamily="{StaticResource FontFamilyMono}"
                               Text="{Binding Path}"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Column="0"
                               Grid.Row="2"
                               Foreground="{StaticResource ForegroundDim}"
                               Text="Status:" />
                    <TextBlock Grid.Column="1"
                               Grid.Row="2"
                               Foreground="{Binding Validity, Converter={StaticResource ValidityToBrush}}"
                               Text="{Binding StatusText}" />

                    <TextBlock Grid.Column="0"
                               Grid.Row="3"
                               Foreground="{StaticResource ForegroundDim}"
                               Text="Default:" />
                    <TextBlock Grid.Column="1"
                               Grid.Row="3"
                               Text="{Binding DefaultText}" />

                    <TextBlock Grid.Column="0"
                               Grid.Row="4"
                               Foreground="{StaticResource ForegroundDim}"
                               Text="Added:" />
                    <TextBlock Grid.Column="1"
                               Grid.Row="4"
                               Text="{Binding AddedText}" />

                    <TextBlock Grid.Column="0"
                               Grid.Row="5"
                               Foreground="{StaticResource ForegroundDim}"
                               Text="Last opened:" />
                    <TextBlock Grid.Column="1"
                               Grid.Row="5"
                               Text="{Binding LastOpenedText}" />

                    <TextBlock Grid.Column="0"
                               Grid.Row="6"
                               Foreground="{StaticResource ForegroundDim}"
                               Text="Last played:" />
                    <TextBlock Grid.Column="1"
                               Grid.Row="6"
                               Text="{Binding LastPlayedText}" />

                    <TextBlock Grid.Column="0"
                               Grid.Row="7"
                               Foreground="{StaticResource ForegroundDim}"
                               Text="History entries:" />
                    <TextBlock Grid.Column="1"
                               Grid.Row="7"
                               Text="{Binding HistoryEntriesText}" />
                </Grid>

                <Button Command="{Binding CloseCommand}"
                        Content="Close"
                        HorizontalAlignment="Right"
                        IsCancel="True"
                        IsDefault="True"
                        Margin="{tokens:Space Top=GapUnrelated}"
                        Classes="DialogButton" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</ClassicWindow>
