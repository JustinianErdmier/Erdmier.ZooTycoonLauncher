<ClassicWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:tokens="using:Erdmier.ZooTycoonNexus.Desktop.Styles"
               xmlns:vm="using:Erdmier.ZooTycoonNexus.Desktop.ViewModels.Dialogs"
               xmlns:common="using:Erdmier.ZooTycoonNexus.Desktop.Views.Common"
               x:Class="Erdmier.ZooTycoonNexus.Desktop.Views.Dialogs.InstallationManagerDialogView"
               x:DataType="vm:InstallationManagerDialogViewModel"
               Icon="/Assets/Win95Icons/installationoncomputer16.ico"
               Title="  Installation Manager"
               Width="560"
               SizeToContent="Height"
               CanResize="False"
               WindowStartupLocation="CenterOwner"
               ShowInTaskbar="False">
    <DockPanel Margin="{tokens:Space MarginDialog}">
        <!-- Footer: helper text, then Close on its own row -->
        <StackPanel DockPanel.Dock="Bottom"
                    Margin="{tokens:Space Top=GapUnrelated}"
                    Spacing="{StaticResource GapRelated}">
            <TextBlock Text="{Binding Grid.Rows.Count, StringFormat='{}{0} installation(s) registered. Double-click a row to open.'}"
                       Classes="MutedText" />

            <Button Command="{Binding CloseCommand}"
                    Content="Close"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    IsCancel="True"
                    Classes="DialogButton" />
        </StackPanel>

        <!-- Right-side action panel -->
        <StackPanel DockPanel.Dock="Right"
                    Margin="{tokens:Space Left=GapRelated}"
                    Spacing="{StaticResource GapRelated}"
                    Width="80">
            <Button Command="{Binding AddCommand}"
                    Content="Add…"
                    HorizontalAlignment="Stretch" />

            <Button Command="{Binding InfoCommand}"
                    Content="Info"
                    HorizontalAlignment="Stretch" />

            <Button Command="{Binding EditCommand}"
                    Content="Edit…"
                    HorizontalAlignment="Stretch" />

            <Button Command="{Binding DeleteCommand}"
                    Content="Delete"
                    HorizontalAlignment="Stretch" />

            <Button Command="{Binding FixCommand}"
                    Content="Fix…"
                    HorizontalAlignment="Stretch"
                    Margin="{tokens:Space Top=GapUnrelated}" />
        </StackPanel>

        <!-- Grid fills remaining space -->
        <common:InstallationGridView DataContext="{Binding Grid}"
                                     Height="220" />
    </DockPanel>
</ClassicWindow>
