<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tokens="using:Erdmier.ZooTycoonNexus.Desktop.Styles"
             xmlns:vm="using:Erdmier.ZooTycoonNexus.Desktop.ViewModels.IniConfig"
             x:Class="Erdmier.ZooTycoonNexus.Desktop.Views.IniConfig.IniEditorView"
             x:DataType="vm:IniEditorViewModel">
    <UserControl.Styles>
        <!-- The INI style lists its sections by their bracketed names in the monospace key face; the Friendly style leaves the system face. -->
        <Style Selector="TextBlock.Mono">
            <Setter Property="FontFamily"
                    Value="{StaticResource FontFamilyMono}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="170,*"
          ColumnSpacing="{StaticResource GapRelated}"
          Margin="{tokens:Space MarginDialog}"
          RowDefinitions="Auto,300,Auto"
          RowSpacing="{StaticResource GapRelated}">
        <TextBlock Foreground="{StaticResource ForegroundMuted}"
                   Grid.Column="0"
                   Grid.Row="0"
                   IsVisible="{Binding SelectedSection.IsIniStyle}"
                   Text="Section" />

        <TextBlock Foreground="{StaticResource ForegroundMuted}"
                   Grid.Column="0"
                   Grid.Row="0"
                   IsVisible="{Binding SelectedSection.IsFriendlyStyle}"
                   Text="Page" />

        <!-- The Friendly style shows the description in the page header, so only the INI style repeats it here. -->
        <TextBlock Foreground="{StaticResource ForegroundMuted}"
                   Grid.Column="1"
                   Grid.Row="0"
                   IsVisible="{Binding SelectedSection.IsIniStyle}"
                   Text="{Binding SelectedSection.Descriptor}" />

        <ListBox Grid.Column="0"
                 Grid.Row="1"
                 IsEnabled="{Binding !IsBusy}"
                 ItemsSource="{Binding Sections}"
                 SelectedItem="{Binding SelectedSection}"
                 SelectionMode="AlwaysSelected">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:IniSectionViewModel">
                    <TextBlock Classes.Mono="{Binding IsIniStyle}"
                               Text="{Binding Title}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Background="{StaticResource InputBackground}"
                BorderBrush="{StaticResource MidShadow}"
                BorderThickness="1"
                Grid.Column="1"
                Grid.Row="1"
                IsEnabled="{Binding !IsBusy}"
                KeyDown="OnFormKeyDown"
                PointerPressed="OnFormPointerPressed">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding SelectedSection}"
                                Margin="{tokens:Space Horizontal=GapUnrelated, Vertical=GapRelated}" />
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Grid.Row="2">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="{StaticResource GapRelated}">
                <Button Command="{Binding RestorePreviousCommand}"
                        Content="Restore previous…"
                        Classes="DialogButton" />

                <Button Command="{Binding RestoreDefaultsCommand}"
                        Content="Restore defaults"
                        Classes="DialogButton" />

                <Button Command="{Binding SaveCommand}"
                        Content="Save"
                        IsDefault="True"
                        Classes="DialogButton" />

                <Button Command="{Binding ResetCommand}"
                        Content="Reset"
                        Classes="DialogButton" />
            </StackPanel>

            <Panel VerticalAlignment="Center">
                <TextBlock FontStyle="Italic"
                           IsVisible="{Binding IsFooterHelp}"
                           Text="{Binding FooterText}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock FontWeight="{StaticResource FontWeightStrong}"
                           Foreground="{StaticResource AccentMaroon}"
                           IsVisible="{Binding IsFooterDirty}"
                           Text="{Binding FooterText}" />

                <TextBlock Foreground="{StaticResource ForegroundMuted}"
                           IsVisible="{Binding IsFooterSaved}"
                           Text="{Binding FooterText}" />
            </Panel>
        </DockPanel>
    </Grid>
</UserControl>
