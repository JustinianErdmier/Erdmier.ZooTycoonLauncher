<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Erdmier.ZooTycoonLauncher.Launcher.App"
             RequestedThemeVariant="Default">
    <!--“Default” ThemeVariant follows the system theme variant. “Dark” or “Light” are other available options.-->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
