<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:launcher="clr-namespace:Erdmier.ZooTycoonLauncher.Launcher"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="Erdmier.ZooTycoonLauncher.Launcher.App"
             RequestedThemeVariant="Default">
    <!--“Default” ThemeVariant follows the system theme variant. “Dark” or “Light” are other available options.-->

    <Application.DataTemplates>
        <launcher:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <semi:SemiTheme Locale="en-GB" />
        <semi:DataGridSemiTheme />
        <semi:DockSemiTheme />
    </Application.Styles>
</Application>
