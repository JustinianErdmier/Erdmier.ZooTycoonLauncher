<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Erdmier.ZooTycoonLauncher.Launcher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Classic.Avalonia.Theme.Controls;assembly=Classic.Avalonia.Theme"
        xmlns:models="clr-namespace:Erdmier.ZooTycoonLauncher.Launcher.Models"
        mc:Ignorable="d"
        d:DesignWidth="408"
        d:DesignHeight="484"
        x:Class="Erdmier.ZooTycoonLauncher.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/ZooTycoonLogo.png"
        Title="  Zoo Tycoon Launcher"
        Width="408"
        Height="484"
        CanMaximize="False"
        CanMinimize="False"
        CanResize="False">

    <!--The Classic theme's caption-button template doesn't honour CanMinimize/CanMaximize — only :fullscreen and :dialog:cantresize.-->
    <!--Collapse those parts. Hide them explicitly here since this window never minimises or maximises.-->
    <Window.Styles>
        <Style Selector="CaptionButtons /template/ Button#PART_MinimizeButton">
            <Setter Property="IsVisible"
                    Value="False" />
        </Style>
        <Style Selector="CaptionButtons /template/ Button#PART_RestoreButton">
            <Setter Property="IsVisible"
                    Value="False" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <!--This only sets the DataContext for the previewer in the IDE. To set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs).-->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <Panel DockPanel.Dock="Top">
            <Menu>
                <MenuItem Header="File">

                    <!--INI — Should only be visible when on the INI Config tab,-->
                    <!--<MenuItem Header="Load New INI" />-->
                    <!-- -->
                    <!--<MenuItem Header="Restore Previous INI" />-->
                    <!-- -->
                    <!--<MenuItem Header="Save Changes to INI" />-->
                    <!-- -->
                    <!--<MenuItem Header="Restore to Default INI" />-->
                    <!-- -->
                    <!-- <Separator /> -->

                    <!--Saves — Should only be visible when on the Save Files tab.-->
                    <!--<MenuItem Header="Import Save File(s)" />-->
                    <!-- -->
                    <!--<MenuItem Header="Create Backup(s)" />-->
                    <!-- -->
                    <!--<MenuItem Header="Restore Backup(s)" />-->
                    <!-- -->
                    <!-- <Separator /> -->

                    <MenuItem Header="Add Installation…"
                              Command="{Binding LocateManuallyCommand}" />

                    <MenuItem Header="Settings" />
                </MenuItem>

                <MenuItem Header="Help">
                    <MenuItem Header="About" />

                    <MenuItem Header="Wiki" />
                </MenuItem>
            </Menu>

        </Panel>

        <Separator DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Top"
                Padding="6,4"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="Installation:"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ActiveInstallation.DisplayName, FallbackValue='(none)', TargetNullValue='(none)'}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2"
                        Content="Change…"
                        Command="{Binding ChangeInstallationCommand}"
                        Margin="6,0"
                        Padding="6,2" />
                <Button Grid.Column="3"
                        Content="Manage…"
                        Command="{Binding ManageInstallationsCommand}"
                        Padding="6,2" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="8,4"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsStatusBarVisible}">
            <Grid ColumnDefinitions="Auto,*">
                <ProgressBar Grid.Column="0"
                             Grid.Row="0"
                             IsIndeterminate="{Binding IsBusy}"
                             IsVisible="{Binding IsBusy}"
                             Width="200" />
                <TextBlock Grid.Column="1"
                           Grid.Row="0"
                           Text="{Binding StatusMessage}"
                           HorizontalAlignment="Center" />
            </Grid>
        </Border>

        <Panel DockPanel.Dock="Top">
            <TabControl IsEnabled="{Binding HasIni}">
                <TabItem Header="General">
                    <StackPanel>
                        <controls:GroupBox Header="Overview">
                            <Grid ColumnDefinitions="Auto,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                  Margin="6,4">
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Status:"
                                           Margin="0,0,8,4" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding StatusMessage}"
                                           Margin="0,0,0,4"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Desktop resolution:"
                                           Margin="0,0,8,4" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="1920 × 1080 @ 60 Hz"
                                           Margin="0,0,0,4" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Available screen modes:"
                                           Margin="0,0,8,4"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="252"
                                           Margin="0,0,0,4"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="Detected Zoo Tycoon resolutions:"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="14"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </controls:GroupBox>

                        <controls:GroupBox Header="File Paths">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  Margin="6,4">
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="zoo.exe:"
                                           Margin="0,0,8,4"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding ExePath, FallbackValue='(not found)', TargetNullValue='(not found)'}"
                                           Margin="0,0,8,4"
                                           TextWrapping="Wrap" />
                                <Button Grid.Row="0"
                                        Grid.Column="2"
                                        Content="Open"
                                        ToolTip.Tip="Show in File Explorer"
                                        Command="{Binding RevealInExplorerCommand}"
                                        CommandParameter="{Binding ExePath}"
                                        IsEnabled="{Binding HasExe}"
                                        Margin="0,0,0,4"
                                        VerticalAlignment="Top" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="zoo.ini:"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding IniPath, FallbackValue='(not found)', TargetNullValue='(not found)'}"
                                           Margin="0,0,8,0"
                                           TextWrapping="Wrap" />
                                <Button Grid.Row="1"
                                        Grid.Column="2"
                                        Content="Open"
                                        ToolTip.Tip="Show in File Explorer"
                                        Command="{Binding RevealInExplorerCommand}"
                                        CommandParameter="{Binding IniPath}"
                                        IsEnabled="{Binding HasIni}"
                                        VerticalAlignment="Top" />
                            </Grid>
                        </controls:GroupBox>

                        <!--Pending-INI-changes warning. Placeholder for the eventual modal dialogue (per user direction);
                            for now it sits inline above the button and only renders when there are unsaved INI edits.-->
                        <TextBlock Text="You have unsaved INI changes. Save or discard them on the INI Configurations tab before launching."
                                   IsVisible="{Binding HasPendingIniChanges}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Stretch"
                                   TextAlignment="Center"
                                   FontStyle="Italic"
                                   Margin="0,16,0,0" />

                        <!--Button uses the RelayCommand's CanExecute (HasExe && !HasPendingIniChanges) to drive IsEnabled — no separate IsEnabled binding needed.-->
                        <Button Content="Launch Game"
                                Command="{Binding LaunchGameCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                FontWeight="Bold" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="INI Configurations">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Bottom"
                                Padding="6,8,6,4">
                            <!--Three-button row over a status/description line. Discard (left), Undo (centre — stubbed, disabled), Save (right).
                                The TextBlock below the buttons shows save/discard feedback at rest and field descriptions while hovering over a control.
                                All three buttons drive their disabled state from their RelayCommand's CanExecute, so no IsEnabled bindings are needed here.-->
                            <StackPanel Spacing="6">
                                <TextBox Text="{Binding Ini.DisplayStatus}"
                                         HorizontalAlignment="Stretch"
                                         IsEnabled="False"
                                         TextAlignment="Center"
                                         TextWrapping="Wrap"
                                         Foreground="Black"
                                         Padding="5 0"
                                         MinHeight="75" />

                                <Grid ColumnDefinitions="*,*,*">
                                    <Button Grid.Column="0"
                                            Content="Discard"
                                            HorizontalAlignment="Left"
                                            Command="{Binding Ini.DiscardCommand}" />
                                    <Button Grid.Column="1"
                                            Content="Undo"
                                            HorizontalAlignment="Center"
                                            Command="{Binding Ini.UndoCommand}" />
                                    <Button Grid.Column="2"
                                            Content="Save"
                                            HorizontalAlignment="Right"
                                            FontWeight="Bold"
                                            Command="{Binding Ini.SaveCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <ScrollViewer x:Name="IniScrollViewer"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6"
                                        Spacing="6"
                                        x:Name="IniGroupContainer">
                                <controls:GroupBox Header="Display and Performance">
                                    <Grid ColumnDefinitions="Auto,*,Auto,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto"
                                          Margin="6,4">

                                        <!--Row 0 — Screen mode drop-down (spans cols 1–3).-->
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="Screen mode:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="0"
                                                  Grid.Column="1"
                                                  Grid.ColumnSpan="3"
                                                  SelectedIndex="{Binding Ini.ScreenModeIndex}"
                                                  Tag="{Binding Ini.ScreenModeTooltip}"
                                                  Margin="0,0,0,4">
                                            <ComboBoxItem>Fullscreen</ComboBoxItem>
                                            <ComboBoxItem>Windowed</ComboBoxItem>
                                        </ComboBox>

                                        <!--Row 1 — Width and height adjacent.-->
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="Screen width:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="1"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.ScreenWidth}"
                                                       Minimum="{x:Static models:IniRanges.ScreenWidthMin}"
                                                       Maximum="{x:Static models:IniRanges.ScreenWidthMax}"
                                                       Increment="1"
                                                       Tag="{Binding Ini.ScreenWidthTooltip}"
                                                       Margin="0,0,12,4" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="2"
                                                   Text="Screen height:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="1"
                                                       Grid.Column="3"
                                                       Value="{Binding Ini.ScreenHeight}"
                                                       Minimum="{x:Static models:IniRanges.ScreenHeightMin}"
                                                       Maximum="{x:Static models:IniRanges.ScreenHeightMax}"
                                                       Increment="1"
                                                       Tag="{Binding Ini.ScreenHeightTooltip}"
                                                       Margin="0,0,0,4" />

                                        <!--Row 2 — Update rate (spans cols 1–3).-->
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="Update rate (ticks/sec):"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="2"
                                                       Grid.Column="1"
                                                       Grid.ColumnSpan="3"
                                                       Value="{Binding Ini.UpdateRate}"
                                                       Minimum="{x:Static models:IniRanges.UpdateRateMin}"
                                                       Maximum="{x:Static models:IniRanges.UpdateRateMax}"
                                                       Increment="1"
                                                       Tag="{Binding Ini.UpdateRateTooltip}"
                                                       Margin="0,0,0,4" />

                                        <!--Row 3 — Draw rate (spans cols 1–3).-->
                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   Text="Draw rate (FPS cap):"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="3"
                                                       Grid.Column="1"
                                                       Grid.ColumnSpan="3"
                                                       Value="{Binding Ini.DrawRate}"
                                                       Minimum="{x:Static models:IniRanges.DrawRateMin}"
                                                       Maximum="{x:Static models:IniRanges.DrawRateMax}"
                                                       Increment="1"
                                                       Tag="{Binding Ini.DrawRateTooltip}" />
                                    </Grid>
                                </controls:GroupBox>

                                <controls:GroupBox Header="Graphics Quality">
                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                          Margin="6,4">
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="Quality preset:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="0"
                                                  Grid.Column="1"
                                                  SelectedIndex="{Binding Ini.Level}"
                                                  Tag="{Binding Ini.LevelTooltip}"
                                                  Margin="0,0,0,4">
                                            <ComboBoxItem>0 — Total Quality</ComboBoxItem>
                                            <ComboBoxItem>1 — Quality</ComboBoxItem>
                                            <ComboBoxItem>2 — Balance</ComboBoxItem>
                                            <ComboBoxItem>3 — Speed</ComboBoxItem>
                                            <ComboBoxItem>4 — Paused</ComboBoxItem>
                                        </ComboBox>

                                        <CheckBox Grid.Row="1"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Content="Load reduced-detail animations"
                                                  IsChecked="{Binding Ini.LoadHalfAnims}"
                                                  Tag="{Binding Ini.LoadHalfAnimsTooltip}"
                                                  Margin="0,0,0,4" />
                                        <CheckBox Grid.Row="2"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Content="Reduce quality during drag"
                                                  IsChecked="{Binding Ini.Drag}"
                                                  Tag="{Binding Ini.DragTooltip}"
                                                  Margin="0,0,0,4" />
                                        <CheckBox Grid.Row="3"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Content="Reduce quality during click"
                                                  IsChecked="{Binding Ini.Click}"
                                                  Tag="{Binding Ini.ClickTooltip}"
                                                  Margin="0,0,0,4" />
                                        <CheckBox Grid.Row="4"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Content="Reduce quality during normal operation"
                                                  IsChecked="{Binding Ini.Normal}"
                                                  Tag="{Binding Ini.NormalTooltip}" />
                                    </Grid>
                                </controls:GroupBox>

                                <controls:GroupBox Header="Audio">
                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                          Margin="6,4">
                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Content="Play menu music"
                                                  IsChecked="{Binding Ini.PlayMenuMusic}"
                                                  Tag="{Binding Ini.PlayMenuMusicTooltip}"
                                                  Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="Menu music file:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Text="{Binding Ini.MenuMusic}"
                                                 Tag="{Binding Ini.MenuMusicTooltip}"
                                                 Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="Menu music attenuation:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="2"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.MenuMusicAttenuation}"
                                                       Minimum="{x:Static models:IniRanges.MenuMusicAttenuationMin}"
                                                       Maximum="{x:Static models:IniRanges.MenuMusicAttenuationMax}"
                                                       Increment="100"
                                                       Tag="{Binding Ini.MenuMusicAttenuationTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   Text="Global attenuation:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="3"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.UserAttenuation}"
                                                       Minimum="{x:Static models:IniRanges.UserAttenuationMin}"
                                                       Maximum="{x:Static models:IniRanges.UserAttenuationMax}"
                                                       Increment="100"
                                                       Tag="{Binding Ini.UserAttenuationTooltip}"
                                                       Margin="0,0,0,4" />

                                        <CheckBox Grid.Row="4"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Content="Play first intro movie"
                                                  IsChecked="{Binding Ini.PlayMovie}"
                                                  Tag="{Binding Ini.PlayMovieTooltip}"
                                                  Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="5"
                                                   Grid.Column="0"
                                                   Text="Movie 1 volume:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="5"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.MovieVolume1}"
                                                       Minimum="{x:Static models:IniRanges.MovieVolumeMin}"
                                                       Maximum="{x:Static models:IniRanges.MovieVolumeMax}"
                                                       Increment="100"
                                                       Tag="{Binding Ini.MovieVolume1Tooltip}"
                                                       Margin="0,0,0,4" />

                                        <CheckBox Grid.Row="6"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Content="Play second intro movie"
                                                  IsChecked="{Binding Ini.PlaySecondMovie}"
                                                  Tag="{Binding Ini.PlaySecondMovieTooltip}"
                                                  Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="7"
                                                   Grid.Column="0"
                                                   Text="Movie 2 volume:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="7"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.MovieVolume2}"
                                                       Minimum="{x:Static models:IniRanges.MovieVolumeMin}"
                                                       Maximum="{x:Static models:IniRanges.MovieVolumeMax}"
                                                       Increment="100"
                                                       Tag="{Binding Ini.MovieVolume2Tooltip}"
                                                       Margin="0,0,0,4" />

                                        <CheckBox Grid.Row="8"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Content="Force 8-bit audio (compatibility)"
                                                  IsChecked="{Binding Ini.Use8BitSound}"
                                                  Tag="{Binding Ini.Use8BitSoundTooltip}" />
                                    </Grid>
                                </controls:GroupBox>

                                <controls:GroupBox Header="Gameplay">
                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                          Margin="6,4">
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="Starting cash:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="0"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.StartingCash}"
                                                       Minimum="{x:Static models:IniRanges.StartingCashMin}"
                                                       Maximum="{x:Static models:IniRanges.StartingCashMax}"
                                                       Increment="1000"
                                                       Tag="{Binding Ini.StartingCashTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="Cash increment:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="1"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.CashIncrement}"
                                                       Minimum="{x:Static models:IniRanges.CashIncrementMin}"
                                                       Maximum="{x:Static models:IniRanges.CashIncrementMax}"
                                                       Increment="100"
                                                       Tag="{Binding Ini.CashIncrementTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="Minimum cash:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="2"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.MinCash}"
                                                       Minimum="{x:Static models:IniRanges.MinCashMin}"
                                                       Maximum="{x:Static models:IniRanges.MinCashMax}"
                                                       Increment="1000"
                                                       Tag="{Binding Ini.MinCashTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   Text="Maximum cash:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="3"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.MaxCash}"
                                                       Minimum="{x:Static models:IniRanges.MaxCashMin}"
                                                       Maximum="{x:Static models:IniRanges.MaxCashMax}"
                                                       Increment="1000"
                                                       Tag="{Binding Ini.MaxCashTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="0"
                                                   Text="Maximum guests:"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="4"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.MaxGuests}"
                                                       Minimum="{x:Static models:IniRanges.MaxGuestsMin}"
                                                       Maximum="{x:Static models:IniRanges.MaxGuestsMax}"
                                                       Increment="50"
                                                       Tag="{Binding Ini.MaxGuestsTooltip}" />
                                    </Grid>
                                </controls:GroupBox>

                                <controls:GroupBox Header="Interface">
                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                          Margin="6,4">
                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Content="Use alternate (monochrome) cursors"
                                                  IsChecked="{Binding Ini.UseAlternateCursors}"
                                                  Tag="{Binding Ini.UseAlternateCursorsTooltip}"
                                                  Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="Tooltip delay (sec):"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="1"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.TooltipDelay}"
                                                       Minimum="{x:Static models:IniRanges.TooltipDelayMin}"
                                                       Maximum="{x:Static models:IniRanges.TooltipDelayMax}"
                                                       Increment="1"
                                                       Tag="{Binding Ini.TooltipDelayTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="Tooltip duration (ms):"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="2"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.TooltipDuration}"
                                                       Minimum="{x:Static models:IniRanges.TooltipDurationMin}"
                                                       Maximum="{x:Static models:IniRanges.TooltipDurationMax}"
                                                       Increment="100"
                                                       Tag="{Binding Ini.TooltipDurationTooltip}"
                                                       Margin="0,0,0,4" />

                                        <CheckBox Grid.Row="3"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Content="Show in-game notification messages"
                                                  IsChecked="{Binding Ini.MessageDisplay}"
                                                  Tag="{Binding Ini.MessageDisplayTooltip}"
                                                  Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="0"
                                                   Text="Mouse scroll threshold (px):"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="4"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.MouseScrollThreshold}"
                                                       Minimum="{x:Static models:IniRanges.MouseScrollThresholdMin}"
                                                       Maximum="{x:Static models:IniRanges.MouseScrollThresholdMax}"
                                                       Increment="1"
                                                       Tag="{Binding Ini.MouseScrollThresholdTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="5"
                                                   Grid.Column="0"
                                                   Text="Mouse scroll delay:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="5"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.MouseScrollDelay}"
                                                       Minimum="{x:Static models:IniRanges.MouseScrollDelayMin}"
                                                       Maximum="{x:Static models:IniRanges.MouseScrollDelayMax}"
                                                       Increment="1"
                                                       Tag="{Binding Ini.MouseScrollDelayTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="6"
                                                   Grid.Column="0"
                                                   Text="Mouse scroll X speed:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="6"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.MouseScrollX}"
                                                       Minimum="{x:Static models:IniRanges.MouseScrollSpeedMin}"
                                                       Maximum="{x:Static models:IniRanges.MouseScrollSpeedMax}"
                                                       Increment="1"
                                                       Tag="{Binding Ini.MouseScrollXTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="7"
                                                   Grid.Column="0"
                                                   Text="Mouse scroll Y speed:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="7"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.MouseScrollY}"
                                                       Minimum="{x:Static models:IniRanges.MouseScrollSpeedMin}"
                                                       Maximum="{x:Static models:IniRanges.MouseScrollSpeedMax}"
                                                       Increment="1"
                                                       Tag="{Binding Ini.MouseScrollYTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="8"
                                                   Grid.Column="0"
                                                   Text="Keyboard scroll X speed:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="8"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.KeyScrollX}"
                                                       Minimum="{x:Static models:IniRanges.KeyScrollSpeedMin}"
                                                       Maximum="{x:Static models:IniRanges.KeyScrollSpeedMax}"
                                                       Increment="1"
                                                       Tag="{Binding Ini.KeyScrollXTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="9"
                                                   Grid.Column="0"
                                                   Text="Keyboard scroll Y speed:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="9"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.KeyScrollY}"
                                                       Minimum="{x:Static models:IniRanges.KeyScrollSpeedMin}"
                                                       Maximum="{x:Static models:IniRanges.KeyScrollSpeedMax}"
                                                       Increment="1"
                                                       Tag="{Binding Ini.KeyScrollYTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="10"
                                                   Grid.Column="0"
                                                   Text="Min message interval (sec):"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="10"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.MinimumMessageInterval}"
                                                       Minimum="{x:Static models:IniRanges.MinimumMessageIntervalMin}"
                                                       Maximum="{x:Static models:IniRanges.MinimumMessageIntervalMax}"
                                                       Increment="10"
                                                       Tag="{Binding Ini.MinimumMessageIntervalTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="11"
                                                   Grid.Column="0"
                                                   Text="Help verbosity:"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="11"
                                                  Grid.Column="1"
                                                  SelectedIndex="{Binding Ini.HelpType}"
                                                  Tag="{Binding Ini.HelpTypeTooltip}">
                                            <ComboBoxItem>0 — Off</ComboBoxItem>
                                            <ComboBoxItem>1 — Standard</ComboBoxItem>
                                            <ComboBoxItem>2 — Verbose</ComboBoxItem>
                                        </ComboBox>
                                    </Grid>
                                </controls:GroupBox>

                                <controls:GroupBox Header="Map">
                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto"
                                          Margin="6,4">
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="Default zoo width (tiles):"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="0"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.MapX}"
                                                       Minimum="{x:Static models:IniRanges.MapDimensionMin}"
                                                       Maximum="{x:Static models:IniRanges.MapDimensionMax}"
                                                       Increment="1"
                                                       Tag="{Binding Ini.MapXTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="Default zoo height (tiles):"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="1"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.MapY}"
                                                       Minimum="{x:Static models:IniRanges.MapDimensionMin}"
                                                       Maximum="{x:Static models:IniRanges.MapDimensionMax}"
                                                       Increment="1"
                                                       Tag="{Binding Ini.MapYTooltip}" />
                                    </Grid>
                                </controls:GroupBox>

                                <controls:GroupBox Header="Language">
                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto"
                                          Margin="6,4">
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="Language:"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="0"
                                                  Grid.Column="1"
                                                  ItemsSource="{Binding Ini.LanguageOptions}"
                                                  SelectedItem="{Binding Ini.SelectedLanguage}"
                                                  Tag="{Binding Ini.LanguageTooltip}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="vm:LanguageOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </controls:GroupBox>

                                <controls:GroupBox Header="Debug">
                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                          Margin="6,4">
                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Content="Show FPS counter overlay"
                                                  IsChecked="{Binding Ini.DrawFps}"
                                                  Tag="{Binding Ini.DrawFpsTooltip}"
                                                  Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="FPS overlay X (px):"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="1"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.DrawFpsX}"
                                                       Minimum="{x:Static models:IniRanges.DrawFpsPositionMin}"
                                                       Maximum="{x:Static models:IniRanges.DrawFpsPositionMax}"
                                                       Increment="10"
                                                       Tag="{Binding Ini.DrawFpsXTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="FPS overlay Y (px):"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="2"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.DrawFpsY}"
                                                       Minimum="{x:Static models:IniRanges.DrawFpsPositionMin}"
                                                       Maximum="{x:Static models:IniRanges.DrawFpsPositionMax}"
                                                       Increment="10"
                                                       Tag="{Binding Ini.DrawFpsYTooltip}"
                                                       Margin="0,0,0,4" />

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   Text="Log verbosity cutoff:"
                                                   Margin="0,0,8,4"
                                                   VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="3"
                                                       Grid.Column="1"
                                                       Value="{Binding Ini.LogCutoff}"
                                                       Minimum="{x:Static models:IniRanges.LogCutoffMin}"
                                                       Maximum="{x:Static models:IniRanges.LogCutoffMax}"
                                                       Increment="1"
                                                       Tag="{Binding Ini.LogCutoffTooltip}"
                                                       Margin="0,0,0,4" />

                                        <CheckBox Grid.Row="4"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Content="Write log file to disk"
                                                  IsChecked="{Binding Ini.SendLogfile}"
                                                  Tag="{Binding Ini.SendLogfileTooltip}"
                                                  Margin="0,0,0,4" />
                                        <CheckBox Grid.Row="5"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Content="Send log output to attached debugger"
                                                  IsChecked="{Binding Ini.SendDebugger}"
                                                  Tag="{Binding Ini.SendDebuggerTooltip}" />
                                    </Grid>
                                </controls:GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Save Files" />

                <TabItem Header="Custom Content" />
            </TabControl>
        </Panel>
    </DockPanel>
</Window>
